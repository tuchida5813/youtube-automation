# ──────────────────────────────────────────────
# Anthropic API
# https://console.anthropic.com/ で取得
# ──────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx

# ──────────────────────────────────────────────
# Slack
# https://api.slack.com/apps でアプリを作成:
#   1. Socket Mode を有効化 → App-Level Token 発行 (xapp-...)
#   2. Slash Commands: /health-news を追加
#   3. Bot Token Scopes: chat:write, commands, files:write
#   4. Bot Token (xoxb-...) を取得
# ──────────────────────────────────────────────
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SLACK_CHANNEL=#health-news

# ──────────────────────────────────────────────
# YouTube
# https://console.cloud.google.com/ でプロジェクト作成:
#   1. YouTube Data API v3 を有効化
#   2. OAuth 2.0 クライアントID（デスクトップアプリ）を作成
#   3. JSON をダウンロードして client_secrets.json として配置
#   ※ 初回実行時にブラウザで認証が必要 → 以降は自動更新
# ──────────────────────────────────────────────
YOUTUBE_CLIENT_SECRETS_FILE=client_secrets.json
YOUTUBE_CREDENTIALS_FILE=youtube_credentials.json
YOUTUBE_PRIVACY=private

# ──────────────────────────────────────────────
# アプリ設定
# ──────────────────────────────────────────────
OUTPUT_DIR=output
DAILY_POST_TIME=09:00
